{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.8.0",
      "excludeFiles": "{node_modules/**,*.sql,uploads/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}