{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,*.md,*.bat}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(?<endpoint>.*)",
      "destination": "/api/index.php?__endpoint=$endpoint"
    },
    {
      "source": "/((?!api/|.*\\.[a-zA-Z0-9]+).*)",
      "destination": "/index.html"
    }
  ]
}
