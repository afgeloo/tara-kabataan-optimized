{
  "functions": {
    "api/*.php": { 
      "runtime": "vercel-php@0.8.0",
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,*.md,*.bat}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|.*\\.[a-zA-Z0-9]+).*)",
      "destination": "/index.html"
    }
  ]
}